<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ToolBox</RootNamespace>
    <AssemblyName>ToolBox</AssemblyName>
    <Version>2.1.0</Version>
    <TaskCliProject>$(MSBuildProjectDirectory)\Cli\ToolBox.Cli.csproj</TaskCliProject>
    <TaskCliOutputDir>$(MSBuildProjectDirectory)\Cli\bin\$(Configuration)\net8.0-windows\$(RuntimeIdentifier)\</TaskCliOutputDir>
    <TaskCliPublishDir>$(MSBuildProjectDirectory)\obj\TaskCliPublish\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\$(SelfContained)\</TaskCliPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
    <PackageReference Include="TesseractOCR" Version="5.5.1" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
    <PackageReference Include="ZString" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Cli\**\*.cs;Tests\**\*.cs" />
    <ApplicationDefinition Remove="Cli\**\*;Tests\**\*" />
    <Content Remove="Cli\**\*;Tests\**\*" />
    <EmbeddedResource Remove="Cli\**\*;Tests\**\*" />
    <None Remove="Cli\**\*;Tests\**\*" />
    <Page Remove="Cli\**\*;Tests\**\*" />
    <Resource Remove="Cli\**\*;Tests\**\*" />
  </ItemGroup>

  <Target Name="BuildTaskCli" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <MSBuild Projects="$(TaskCliProject)" Targets="Restore;Build" BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=net8.0-windows;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />
    <ItemGroup>
      <TaskCliBuildFile Include="$(TaskCliOutputDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(TaskCliBuildFile)"
          DestinationFiles="@(TaskCliBuildFile->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishTaskCli" AfterTargets="ComputeFilesToPublish">
    <MSBuild Projects="$(TaskCliProject)" Targets="Restore;Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=net8.0-windows;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(TaskCliPublishDir)" />
    <ItemGroup>
      <TaskCliPublishFile Include="$(TaskCliPublishDir)**\*" Exclude="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Include="@(TaskCliPublishFile)">
        <RelativePath>%(TaskCliPublishFile.RecursiveDir)%(TaskCliPublishFile.Filename)%(TaskCliPublishFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- 应用自带 VC++ 运行时：防止用户机器 System32 中老版运行时劫持原生 OCR 库依赖导致崩溃 -->
  <ItemGroup>
    <None Include="Natives\VCRuntime\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
