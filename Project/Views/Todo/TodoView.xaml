<UserControl x:Class="ToolBox.Views.Todo.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="DrawerExpander" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,4">
                            <DockPanel>
                                <ToggleButton x:Name="Toggle" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,10">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="Arrow" Text="&#x25BC;" FontSize="10" Margin="0,0,8,0"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter/>
                                </ToggleButton>
                                <Border x:Name="Content" DockPanel.Dock="Bottom" Padding="8,0,8,8">
                                    <ContentPresenter ContentSource="Content"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="35*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: list area -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter Bar -->
            <Border Grid.Row="0" Padding="20,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource BgElevatedBrush}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Content="{DynamicResource Lang_Todo_FilterAll}" IsChecked="True" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="FilterPending" Content="{DynamicResource Lang_Todo_FilterPending}" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="FilterCompleted" Content="{DynamicResource Lang_Todo_FilterCompleted}" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="FilterRepeating" Content="{DynamicResource Lang_Todo_FilterRepeating}" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="FilterTrashed" Content="{DynamicResource Lang_Todo_FilterTrashed}" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                </StackPanel>
            </Border>

            <!-- Todo Drawers -->
            <Grid Grid.Row="1">
                <!-- 空状态 -->
                <Border x:Name="TodoEmptyState" Background="{DynamicResource BgSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusLg}" Margin="24" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Lang_EmptyTodoTitle}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Lang_EmptyTodoHint}" FontSize="13"
                                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,8,8">
                    <StackPanel x:Name="DrawerContainer"/>
                </ScrollViewer>
            </Grid>

            <!-- Floating + button -->
            <Button x:Name="FloatingAddBtn" Grid.Row="2" Width="36" Height="36" Margin="0,0,16,16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Style="{StaticResource BtnPrimary}" Content="+" FontSize="20"
                    Click="FloatingAddBtn_Click" ToolTip="{DynamicResource Lang_Todo_AddTodoTitle}"/>
        </Grid>

        <!-- Right: detail panel -->
        <Border Grid.Column="1" Background="{DynamicResource BgElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource Lang_Todo_TaskDetail}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <Grid x:Name="DetailContainer" Grid.Row="1">
                    <TextBlock x:Name="EmptyHint" Text="{DynamicResource Lang_Todo_SelectTask}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"/>

                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Margin="20,16">
                        <TextBox x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold"
                                 Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                 Padding="0,4" Margin="0,0,0,16"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 LostFocus="DetailTitle_LostFocus"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border x:Name="DetailStatusBadge" CornerRadius="{StaticResource RadiusMd}" Padding="10,2"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock x:Name="DetailStatusText" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Category -->
                        <TextBlock Text="{DynamicResource Lang_Todo_Category}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16" Width="220" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="DetailCategory" Grid.Row="0" FontSize="12" Padding="6,4"
                                     Background="{DynamicResource BgSunkenBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     TextChanged="DetailCategory_TextChanged"
                                     LostFocus="DetailCategory_LostFocus"/>
                            <ListBox x:Name="CategorySuggestions" Grid.Row="1" MaxHeight="100" Margin="0,2,0,0"
                                     Visibility="Collapsed" FontSize="11"
                                     Background="{DynamicResource BgElevatedBrush}"
                                     BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                     SelectionChanged="CategorySuggestion_Selected"/>
                        </Grid>

                        <!-- Priority -->
                        <TextBlock Text="{DynamicResource Lang_Todo_Priority}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="PriLow" Content="{DynamicResource Lang_Todo_PriLow}" Margin="0,0,6,0"
                                         Style="{StaticResource PriOptionStyle}" Click="Priority_Changed"/>
                            <RadioButton x:Name="PriMid" Content="{DynamicResource Lang_Todo_PriMid}" Margin="0,0,6,0"
                                         Style="{StaticResource PriOptionStyle}" Click="Priority_Changed"/>
                            <RadioButton x:Name="PriHigh" Content="{DynamicResource Lang_Todo_PriHigh}"
                                         Style="{StaticResource PriOptionStyle}" Click="Priority_Changed"/>
                        </StackPanel>

                        <!-- Non-repeat fields: due date + progress -->
                        <StackPanel x:Name="DetailNonRepeatSection">
                            <TextBlock Text="{DynamicResource Lang_Todo_DueDate}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <DatePicker x:Name="DetailDueDate" FontSize="12" Margin="0,0,0,16"
                                        SelectedDateChanged="DetailDueDate_Changed"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Text="{DynamicResource Lang_Todo_Progress}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DetailProgress" Grid.Column="0" Minimum="0" Maximum="100"
                                        TickFrequency="10" IsSnapToTickEnabled="True" TickPlacement="None"
                                        ValueChanged="DetailProgress_Changed"/>
                                <TextBlock x:Name="DetailProgressText" Grid.Column="1" Text="0%" Width="36"
                                           TextAlignment="Right" FontSize="12" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Repeat config -->
                        <Border x:Name="DetailRepeatSection" Margin="0,0,0,16" Padding="0" BorderThickness="0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Border Background="{DynamicResource BgSunkenBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Lang_Todo_RepeatSettings}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                        <TextBlock Text="{DynamicResource Lang_Todo_Frequency}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="DetailRepeatFreq" FontSize="12" SelectedIndex="0" Margin="0,0,0,8"
                                                  SelectionChanged="DetailRepeatFreq_SelectionChanged"
                                                  Background="{DynamicResource BgElevatedBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <ComboBoxItem Content="{DynamicResource Lang_Todo_NoRepeat}"/>
                                            <ComboBoxItem Content="{DynamicResource Lang_Todo_Daily}"/>
                                            <ComboBoxItem Content="{DynamicResource Lang_Todo_Weekly}"/>
                                            <ComboBoxItem Content="{DynamicResource Lang_Todo_Monthly}"/>
                                            <ComboBoxItem Content="{DynamicResource Lang_Todo_Yearly}"/>
                                        </ComboBox>

                                        <StackPanel x:Name="DetailRepeatFieldsSection">
                                            <TextBlock Text="{DynamicResource Lang_Todo_ReminderTime}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="DetailRepeatTime" Grid.Column="0" FontSize="12" Padding="6,4"
                                                         Text="09:00"
                                                         Background="{DynamicResource BgSunkenBrush}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"/>
                                            </Grid>

                                            <TextBlock Text="{DynamicResource Lang_Todo_EndDate}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                            <DatePicker x:Name="DetailRepeatEndDate" FontSize="12" Margin="0,0,0,8"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <Button x:Name="DetailRepeatSaveBtn" Content="{DynamicResource Lang_Todo_SetRepeat}"
                                                Padding="14,6" FontSize="12"
                                                Style="{StaticResource BtnPrimary}"
                                                Click="DetailRepeatSave_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Description -->
                        <TextBlock Text="{DynamicResource Lang_Todo_Description}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox x:Name="DetailDesc" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                                 FontSize="13" Padding="10" Margin="0,0,0,16"
                                 Background="{DynamicResource BgSunkenBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 LostFocus="DetailDesc_LostFocus"/>

                        <!-- Timestamps -->
                        <Border Background="{DynamicResource BgSunkenBrush}" CornerRadius="{StaticResource RadiusSm}" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{DynamicResource Lang_Todo_CreatedTime}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Width="60"/>
                                    <TextBlock x:Name="DetailCreated" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Lang_Todo_CompletedTime}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Width="60"/>
                                    <TextBlock x:Name="DetailCompleted" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="{DynamicResource Lang_Todo_AddSubtask}" HorizontalAlignment="Left" Padding="14,6" FontSize="12"
                                    Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"
                                    Click="AddSubTodo_Click"/>
                            <Button x:Name="DetailTrashBtn" Content="{DynamicResource Lang_Todo_TrashTask}"
                                    Padding="14,6" FontSize="12"
                                    Style="{StaticResource OutlineButton}"
                                    Foreground="{DynamicResource DangerBrush}"
                                    BorderBrush="{DynamicResource DangerBrush}"
                                    Click="DetailTrash_Click"/>
                            <Button x:Name="DetailRestoreBtn" Content="{DynamicResource Lang_Todo_Restore}"
                                    Padding="14,6" FontSize="12"
                                    Style="{StaticResource BtnPrimary}"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed"
                                    Click="DetailRestore_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
