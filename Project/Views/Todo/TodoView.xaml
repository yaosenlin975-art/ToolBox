<UserControl x:Class="ToolBox.Views.Todo.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ToolBox.Views.Todo"
             Background="{DynamicResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="DrawerExpander" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}" Margin="0,0,0,4">
                            <DockPanel>
                                <ToggleButton x:Name="Toggle" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,10"
                                              Content="{TemplateBinding Header}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="Arrow" Text="&#x25BC;" FontSize="10" Margin="0,0,8,0"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" ContentSource="Content"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="Content" DockPanel.Dock="Bottom" Padding="8,0,8,8">
                                    <ContentPresenter ContentSource="Content"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="35*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: list area -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter Bar -->
            <Border Grid.Row="0" Padding="20,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource BgElevatedBrush}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="FilterAll" Content="{DynamicResource Lang_Todo_FilterAll}" IsChecked="True" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="FilterPending" Content="{DynamicResource Lang_Todo_FilterPending}" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="FilterCompleted" Content="{DynamicResource Lang_Todo_FilterCompleted}" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="FilterRepeating" Content="{DynamicResource Lang_Todo_FilterRepeating}" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                    <RadioButton x:Name="FilterTrashed" Content="{DynamicResource Lang_Todo_FilterTrashed}" Margin="0,0,4,0"
                                 Style="{StaticResource FilterTabStyle}" Click="Filter_Changed"/>
                </StackPanel>
            </Border>

            <!-- Todo Drawers -->
            <Grid Grid.Row="1">
                <!-- 空状态 -->
                <Border x:Name="TodoEmptyState" Background="{DynamicResource BgSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusLg}" Margin="24" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Lang_EmptyTodoTitle}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Lang_EmptyTodoHint}" FontSize="13"
                                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8,8,8">
                    <StackPanel x:Name="DrawerContainer"/>
                </ScrollViewer>
            </Grid>

            <!-- Floating + button -->
            <Button x:Name="FloatingAddBtn" Grid.Row="2" Width="36" Height="36" Margin="0,0,16,16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Style="{StaticResource BtnPrimary}"
                    Click="FloatingAddBtn_Click" ToolTip="{DynamicResource Lang_Todo_AddTodoTitle}">
                <Path Data="{StaticResource IconAdd}" Width="16" Height="16" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
        </Grid>

        <!-- Right: detail panel (shared component) -->
        <Border Grid.Column="1" Background="{DynamicResource BgElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{DynamicResource Lang_Todo_TaskDetail}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>

                <Grid x:Name="DetailContainer" Grid.Row="1">
                    <TextBlock x:Name="EmptyHint" Text="{DynamicResource Lang_Todo_SelectTask}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="13"/>

                    <local:TodoDetailPanel x:Name="DetailPanel" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
