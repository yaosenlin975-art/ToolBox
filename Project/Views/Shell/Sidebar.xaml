<UserControl x:Class="ToolBox.Views.Shell.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="64">
    <UserControl.Resources>
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="activeBar" Width="3" HorizontalAlignment="Left"
                                    Background="Transparent" CornerRadius="{StaticResource RadiusXs}" Margin="-8,0,0,0"/>
                            <Border x:Name="bg" Background="Transparent" CornerRadius="{StaticResource RadiusSm}">
                                <Grid>
                                    <Path x:Name="icon" Width="18" Height="18" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="activeBar" Property="Background" Value="{DynamicResource SidebarAccentBrush}"/>
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource SidebarBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Width="36" Height="36" Margin="0,16,0,24"
                    CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource AccentBrush}">
                <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <RadioButton x:Name="NavDashboard" GroupName="Nav" IsChecked="True"
                             Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconDashboard}"
                             AutomationProperties.Name="{DynamicResource Lang_Page_Dashboard}" Checked="OnNavChecked"/>
                <RadioButton x:Name="NavTodos" GroupName="Nav"
                             Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconChecklist}"
                             AutomationProperties.Name="{DynamicResource Lang_Page_Todos}" Checked="OnNavChecked"/>
                <RadioButton x:Name="NavBoards" GroupName="Nav"
                             Style="{StaticResource NavItemStyle}"
                             AutomationProperties.Name="{DynamicResource Lang_Page_Boards}" ToolTip="{DynamicResource Lang_Page_Boards}" Checked="OnNavChecked">
                    <RadioButton.Tag>
                        <Geometry>M 3,4 H 10 V 11 H 3 Z M 12,4 H 21 V 8 H 12 Z M 12,10 H 21 V 20 H 12 Z M 3,13 H 10 V 20 H 3 Z</Geometry>
                    </RadioButton.Tag>
                </RadioButton>
                <RadioButton x:Name="NavScreenshots" GroupName="Nav"
                             Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconCamera}"
                             AutomationProperties.Name="{DynamicResource Lang_Page_Screenshots}" Checked="OnNavChecked"/>
                <RadioButton x:Name="NavClipboard" GroupName="Nav"
                             Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconClipboard}"
                             AutomationProperties.Name="{DynamicResource Lang_Page_Clipboard}" Checked="OnNavChecked"/>
                <RadioButton x:Name="NavNetwork" GroupName="Nav"
                             Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconDns}"
                             AutomationProperties.Name="{DynamicResource Lang_NetworkDiagnosis}"
                             ToolTip="{DynamicResource Lang_NetworkDiagnosis}" Checked="OnNavChecked"/>
                <RadioButton x:Name="NavSettings" GroupName="Nav"
                             Style="{StaticResource NavItemStyle}" Tag="{StaticResource IconSettings}"
                             AutomationProperties.Name="{DynamicResource Lang_Settings}" Checked="OnNavChecked"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="v2.0" FontSize="10"
                       Foreground="{DynamicResource SidebarTextBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.6"/>
        </Grid>
    </Border>
</UserControl>
