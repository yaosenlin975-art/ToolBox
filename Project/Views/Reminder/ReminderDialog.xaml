<Window x:Class="ToolBox.Views.Reminder.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提醒" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent">
    <Window.Resources>
        <!-- ── Toggle Switch (与 SettingsView 一致) ── -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Background="{DynamicResource BorderStrongBrush}"
                                CornerRadius="0">
                            <Grid>
                                <Border x:Name="thumbOff" Width="16" Height="16" CornerRadius="0"
                                        Background="{DynamicResource TextPrimaryBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                <Border x:Name="thumbOn" Width="16" Height="16" CornerRadius="0"
                                        Background="White"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="thumbOff" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="thumbOn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BgElevatedBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource BgElevatedBrush}"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TitleDisplay" Text="{DynamicResource Lang_ReminderAddTitle}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Width="28" Height="28" Style="{StaticResource IconButton}"
                        Click="OnClose" Margin="0,0,6,0">
                    <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{DynamicResource Lang_ReminderTitle}" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtTitle" FontSize="13" MaxLength="50"
                             Background="{DynamicResource BgSunkenBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDefaultBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             Padding="8,6"/>
                </StackPanel>

                <!-- 内容 -->
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource Lang_ReminderMessage}" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtMessage" FontSize="13" MaxLength="200" Height="64"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource BgSunkenBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDefaultBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             Padding="8,6"/>
                </StackPanel>

                <!-- 类型 -->
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource Lang_ReminderType}" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rdoOnce" GroupName="ReminderType" Content="{DynamicResource Lang_ReminderTypeOnce}"
                                     Style="{StaticResource ModernRadioButton}" IsChecked="True"
                                     Checked="OnTypeChanged" Margin="0,0,20,0"/>
                        <RadioButton x:Name="rdoRecurring" GroupName="ReminderType" Content="{DynamicResource Lang_ReminderTypeRecurring}"
                                     Style="{StaticResource ModernRadioButton}" Checked="OnTypeChanged"/>
                    </StackPanel>
                </StackPanel>

                <!-- 一次性：触发时间 -->
                <StackPanel x:Name="OncePanel" Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource Lang_ReminderTime}" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker x:Name="datePicker" FontSize="13" Width="170"/>
                        <TextBox x:Name="txtTime" Width="80" FontSize="13" Margin="8,0,0,0" MaxLength="5"
                                 Text="09:00" HorizontalContentAlignment="Center"
                                 FontFamily="{StaticResource FontMono}"
                                 Background="{DynamicResource BgSunkenBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderDefaultBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="HH:mm" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 重复：Cron 表达式 + 预设 -->
                <StackPanel x:Name="RecurringPanel" Grid.Row="4" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Lang_ReminderCron}" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtCron" FontSize="13" MaxLength="64"
                             FontFamily="{StaticResource FontMono}"
                             Background="{DynamicResource BgSunkenBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDefaultBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             Padding="8,6"/>
                    <TextBlock Text="{DynamicResource Lang_ReminderCronPresets}" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,6"/>
                    <WrapPanel>
                        <Button Content="{DynamicResource Lang_ReminderPresetHourly}" Tag="0 * * * *"
                                Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="12" Margin="0,0,8,8"
                                Click="Preset_Click"/>
                        <Button Content="{DynamicResource Lang_ReminderPresetDaily9}" Tag="0 9 * * *"
                                Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="12" Margin="0,0,8,8"
                                Click="Preset_Click"/>
                        <Button Content="{DynamicResource Lang_ReminderPresetDaily18}" Tag="0 18 * * *"
                                Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="12" Margin="0,0,8,8"
                                Click="Preset_Click"/>
                        <Button Content="{DynamicResource Lang_ReminderPresetWeekly}" Tag="0 9 * * 1"
                                Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="12" Margin="0,0,8,8"
                                Click="Preset_Click"/>
                        <Button Content="{DynamicResource Lang_ReminderPresetMonthly}" Tag="0 9 1 * *"
                                Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="12" Margin="0,0,8,8"
                                Click="Preset_Click"/>
                    </WrapPanel>
                </StackPanel>

                <!-- 启用开关 -->
                <Grid Grid.Row="5" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Lang_ReminderEnabled}" FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                              VerticalAlignment="Center"/>
                </Grid>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="{DynamicResource Lang_Cancel}" Width="76" Margin="0,0,8,0"
                            Style="{StaticResource OutlineButton}" Click="Cancel_Click"/>
                    <Button Content="{DynamicResource Lang_OK}" Width="76"
                            Style="{StaticResource BtnPrimary}" Click="OK_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
