<UserControl x:Class="ToolBox.Views.Chat.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ToolBox.Views.Chat"
             Background="Transparent">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 会话侧边栏 -->
        <Border x:Name="SidebarBorder" Grid.Column="0"
                Background="{DynamicResource BgElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="16,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="{DynamicResource LLM.Session.Sessions}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="NewSessionBtn" HorizontalAlignment="Right" Width="28" Height="28"
                                Style="{StaticResource IconButton}" Click="NewSessionBtn_Click" ToolTip="{DynamicResource LLM.Session.NewSession}"
                                Content="+"/>
                    </Grid>
                </Border>
                <ListBox x:Name="SessionList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Padding="6,6,6,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SessionList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBd" Background="Transparent" CornerRadius="{StaticResource RadiusSm}"
                                                Padding="10,8" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="P" FontSize="10" Margin="0,0,4,0"
                                                                   FontFamily="{StaticResource FontSans}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding UpdatedAtLocal, StringFormat='{}{0:MM-dd HH:mm}'}"
                                                               FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </StackPanel>
                                                <Button x:Name="DeleteBtn" Grid.Column="1" Width="22" Height="22"
                                                        Padding="0" VerticalAlignment="Center"
                                                        Style="{StaticResource IconButton}"
                                                        Visibility="Collapsed" Opacity="0"
                                                        Click="DeleteSessionBtn_Click">
                                                    <Path Data="M3,6 L19,6 M8,6 L8,3 L14,3 L14,6 M6,6 L7,19 L15,19 L16,6"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBd" Property="Background"
                                                        Value="{DynamicResource ChatSidebarHoverBrush}"/>
                                                <Setter TargetName="DeleteBtn" Property="Visibility" Value="Visible"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="DeleteBtn"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0.85" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBd" Property="Background"
                                                        Value="{DynamicResource ChatSidebarActiveBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- 对话区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 空状态：无会话时显示 -->
            <Border x:Name="ChatEmptyState" Grid.Row="0"
                    Background="{DynamicResource BgSecondaryBrush}"
                    CornerRadius="{StaticResource RadiusLg}" Margin="24" Padding="32"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💬" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource Lang_EmptyChatTitle}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Lang_EmptyChatHint}" FontSize="13"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"
                               Margin="0,8,0,16"/>
                    <Button Content="{DynamicResource LLM.Session.NewSession}" Style="{StaticResource BtnPrimary}"
                            Padding="18,8" FontSize="13" HorizontalAlignment="Center"
                            Click="NewSessionBtn_Click"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="MessageScroller" Grid.Row="0"
                          VerticalScrollBarVisibility="Auto" Padding="24,16,24,8"
                          Visibility="Collapsed">
                <StackPanel x:Name="MessagePanel" Orientation="Vertical"/>
            </ScrollViewer>

            <Border x:Name="InputAreaBorder" Grid.Row="1" Padding="16,12"
                    Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="{StaticResource RadiusMd}"
                            Background="{DynamicResource BgSunkenBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120"
                                 FontSize="13" Padding="12,10" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 VerticalContentAlignment="Top"
                                 KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"/>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock x:Name="StatusText" Text="{DynamicResource LLM.ChatWindow.Ready}" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="SendBtn" Content="{DynamicResource LLM.ChatWindow.Send}" Padding="18,8" FontSize="13"
                                Style="{StaticResource BtnPrimary}" IsEnabled="False"
                                Click="SendBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
