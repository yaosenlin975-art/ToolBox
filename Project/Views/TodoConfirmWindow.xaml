<Window x:Class="ToolBox.Views.TodoConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办识别结果" Width="420" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <!-- 自定义窗口样式（与 MessageWindow 确认弹窗范式一致）：无系统顶栏，圆角卡片 + 阴影 + 自定义标题栏 -->
    <Border Background="{DynamicResource BgElevatedBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏：拖拽移动 + 关闭按钮 -->
            <Grid Grid.Row="0" Background="{DynamicResource BgElevatedBrush}"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="待办识别结果" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="1" Width="28" Height="28" Style="{StaticResource IconButton}"
                        Click="OnClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Margin="0,0,6,0"/>
            </Grid>

            <Grid Grid.Row="1" Margin="16,12,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="识别到以下待办事项，请确认或编辑：" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                <ListBox x:Name="TodoListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgSecondaryBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13" Background="Transparent" BorderThickness="0,0,0,1"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"/>
                                    <ComboBox Grid.Column="1" Width="60" Margin="8,0,0,0" SelectedIndex="{Binding Priority}"
                                              VerticalAlignment="Center" FontSize="11">
                                        <ComboBoxItem Content="普通"/>
                                        <ComboBoxItem Content="重要"/>
                                        <ComboBoxItem Content="紧急"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="&#xE8BB;" Width="24" Height="24" Margin="6,0,0,0"
                                            FontSize="10" FontFamily="Segoe MDL2 Assets"
                                            Background="Transparent" Foreground="{DynamicResource TextTertiaryBrush}"
                                            BorderThickness="0" Cursor="Hand" Click="RemoveItem_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,16,16">
                <Button Content="+ 添加" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                        Style="{StaticResource OutlineButton}" Click="AddItem_Click"/>
                <Button Content="取消" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                        Style="{StaticResource OutlineButton}" Click="Cancel_Click"/>
                <Button Content="确认创建" Padding="16,6" FontSize="12"
                        Style="{StaticResource BtnPrimary}" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
