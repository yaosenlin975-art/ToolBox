<UserControl x:Class="ToolBox.Views.NetworkDiagnosis.NetworkDiagnosisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}">
    <UserControl.Resources>
        <!-- ── 日志区折叠样式（主题一致，复用 DrawerExpander 范式） ── -->
        <Style x:Key="LogExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <DockPanel>
                                <ToggleButton x:Name="Toggle" DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="12,10">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="Arrow" Text="&#x25BC;" FontSize="9" Margin="0,0,8,0"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               VerticalAlignment="Center"
                                                               RenderTransformOrigin="0.5,0.5">
                                                        <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter/>
                                </ToggleButton>
                                <Border x:Name="Content" DockPanel.Dock="Bottom" Padding="16,4,16,14">
                                    <ContentPresenter ContentSource="Content"/>
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

            <!-- ── Section: 状态区（5.2-1，大字号概览 + 一句话结论） ── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusDot" Width="14" Height="14" CornerRadius="7"
                            Background="{DynamicResource TextTertiaryBrush}"
                            VerticalAlignment="Top" Margin="0,7,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   AutomationProperties.AutomationId="NetStatusTitle"
                                   Text="{DynamicResource Lang_Net_StatusIdle}"/>
                        <TextBlock x:Name="StatusHint" FontSize="13" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{DynamicResource Lang_Net_StatusIdleHint}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Section: 操作区（5.2-2，一键诊断 / 重新检测） ── -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="BtnDiagnose" Content="{DynamicResource Lang_Net_BtnDiagnose}"
                        Style="{StaticResource BtnPrimary}" Padding="20,9" FontSize="14"
                        AutomationProperties.AutomationId="NetBtnDiagnose"
                        Click="BtnDiagnose_Click" IsEnabled="True"/>
                <Button x:Name="BtnRetest" Content="{DynamicResource Lang_Net_BtnRetest}"
                        Style="{StaticResource BtnDefault}" Padding="20,9" FontSize="14"
                        Margin="12,0,0,0" AutomationProperties.AutomationId="NetBtnRetest"
                        Click="BtnDiagnose_Click" Visibility="Collapsed"/>
            </StackPanel>

            <!-- ── Section: 空状态引导（AC-09，无历史记录时不展示空表格） ── -->
            <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Padding="24,32"
                    AutomationProperties.AutomationId="NetEmptyState">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Lang_Net_EmptyTitle}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Lang_Net_EmptyHint}" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Section: 检测结果列表（5.2-3，状态图标 + 名称 + 详情，行展开） ── -->
            <StackPanel x:Name="ResultsSection" Visibility="Collapsed"
                        AutomationProperties.AutomationId="NetResults">
                <TextBlock Text="{DynamicResource Lang_Net_SectionResults}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <StackPanel x:Name="ResultList" AutomationProperties.AutomationId="NetResultList"/>
            </StackPanel>

            <!-- ── Section: 修复区（5.2-4，修复建议卡片，T2 落地完整确认流） ── -->
            <StackPanel x:Name="RepairSection" Visibility="Collapsed" Margin="0,24,0,0"
                        AutomationProperties.AutomationId="NetRepairSection">
                <TextBlock Text="{DynamicResource Lang_Net_SectionRepair}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{DynamicResource WarningBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="RepairTitle" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="RepairImpact" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="BtnRepair" Content="{DynamicResource Lang_Net_BtnRepair}"
                                    Style="{StaticResource BtnPrimary}" Click="BtnRepair_Click"/>
                            <Button x:Name="BtnLater" Content="{DynamicResource Lang_Net_BtnLater}"
                                    Style="{StaticResource BtnDefault}" Margin="12,0,0,0" Click="BtnLater_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── Section: 日志区（5.2-5，折叠式，最近 10 次记录由 T4 落地） ── -->
            <Expander x:Name="LogExpander" Style="{StaticResource LogExpanderStyle}"
                      Margin="0,24,0,0" IsExpanded="False"
                      AutomationProperties.AutomationId="NetLogExpander">
                <Expander.Header>
                    <TextBlock Text="{DynamicResource Lang_Net_SectionLog}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Expander.Header>
                <StackPanel x:Name="LogList" Margin="0,6,0,0">
                    <TextBlock Text="{DynamicResource Lang_Net_LogEmpty}" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
