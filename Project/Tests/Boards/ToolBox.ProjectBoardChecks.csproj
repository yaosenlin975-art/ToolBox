<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 该 harness 只在 Windows 上运行；System.Drawing 的平台分析器告警在此测试工程内抑制。 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="TodoStoreStub.cs" />
    <Compile Include="..\..\Core\Boards\ProjectBoardModels.cs" Link="ProjectBoardModels.cs" />
    <Compile Include="..\..\Core\Boards\ProjectBoardStore.cs" Link="ProjectBoardStore.cs" />
    <Compile Include="..\..\Core\Boards\ProjectBoardComments.cs" Link="ProjectBoardComments.cs" />
    <Compile Include="..\..\Core\Boards\ProjectBoardAttachments.cs" Link="ProjectBoardAttachments.cs" />
    <Compile Include="..\..\Core\Todo\TaskProtocol.cs" Link="TaskProtocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
  </ItemGroup>
</Project>
