<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>toolbox-cli</AssemblyName>
    <RootNamespace>ToolBox.Cli</RootNamespace>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Core\Todo\TaskProtocol.cs" Link="Shared\TaskProtocol.cs" />
    <Compile Include="..\Core\Todo\TaskIpc.cs" Link="Shared\TaskIpc.cs" />
    <Compile Include="..\Core\Todo\AgentCapabilities.cs" Link="Shared\AgentCapabilities.cs" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\Docs\skills\cli-anything-toolbox\SKILL.md" Link="skills\cli-anything-toolbox\SKILL.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
